<script>
/* ============================================================================
   SaivLINK — Single-file client-side URL shortener
   Architecture:
     - Storage       : localStorage-based persistence
     - URLCodec      : base64url encode/decode for hash-safe encoding
     - Router        : hash-based view switching
     - Dashboard     : generator form, result rendering, history
     - RedirectView  : countdown + auto-redirect + skip
     - Utils         : DOM helpers, clipboard, toast, validation
   ============================================================================ */

(function () {
'use strict';

/* ============ CONSTANTS ============ */
const STORAGE = {
  THEME:   'saivlink:theme',
  HISTORY: 'saivlink:history',
  ALIASES: 'saivlink:aliases'
};
const COUNTDOWN_SECONDS = 5;
const MAX_HISTORY = 60;
const CIRCUMFERENCE = 2 * Math.PI * 54; // r=54
const RESERVED_ALIASES = ['home', 'new', 'about', 'help', 'admin', 'api', 'to', 's'];

/* ============ DOM HELPERS ============ */
const $  = (sel, ctx = document) => ctx.querySelector(sel);
const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));

/* ============ APP STATE ============ */
const App = {
  countdown: {
    raf: null,
    startTime: 0,
    duration: COUNTDOWN_SECONDS * 1000,
    target: '',
    completed: false
  },
  currentResult: null, // { id, original, short, alias, createdAt }
  toastTimeout: null
};

/* ============================================================================
   UTILS
   ============================================================================ */

/* --- base64url encoding (URL-safe, no padding) --- */
function b64urlEncode(str) {
  try {
    const utf8 = unescape(encodeURIComponent(str));
    return btoa(utf8)
      .replace(/\+/g, '-')
      .replace(/\//g, '_')
      .replace(/=+$/, '');
  } catch (e) {
    console.error('Encoding failed:', e);
    return '';
  }
}

function b64urlDecode(str) {
  try {
    let s = str.replace(/-/g, '+').replace(/_/g, '/');
    while (s.length % 4) s += '=';
    const raw = atob(s);
    return decodeURIComponent(escape(raw));
  } catch (e) {
    console.error('Decoding failed:', e);
    return null;
  }
}

/* --- URL validation & normalization --- */
function normalizeUrl(input) {
  if (!input) return '';
  let url = String(input).trim();
  if (!url) return '';

  // Add https:// if missing a scheme
  if (!/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(url)) {
    // If it looks like a domain (has a dot and no spaces)
    if (/^[^\s]+\.[^\s]+/.test(url)) {
      url = 'https://' + url;
    } else {
      url = 'https://' + url;
    }
  }
  return url;
}

function isValidHttpUrl(str) {
  try {
    const u = new URL(str);
    return u.protocol === 'http:' || u.protocol === 'https:';
  } catch (e) {
    return false;
  }
}

function getHostname(url) {
  try { return new URL(url).hostname; }
  catch (e) { return ''; }
}

function getFaviconUrl(url) {
  const host = getHostname(url);
  if (!host) return '';
  return `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=64`;
}

function isSecure(url) {
  try { return new URL(url).protocol === 'https:'; }
  catch (e) { return false; }
}

/* --- Truncate URL for display --- */
function truncateUrl(url, max = 60) {
  if (url.length <= max) return url;
  return url.slice(0, max - 1) + '…';
}

/* --- Time formatting --- */
function timeAgo(ts) {
  const diff = Date.now() - ts;
  const s = Math.floor(diff / 1000);
  if (s < 60) return 'just now';
  const m = Math.floor(s / 60);
  if (m < 60) return m + 'm ago';
  const h = Math.floor(m / 60);
  if (h < 24) return h + 'h ago';
  const d = Math.floor(h / 24);
  if (d < 7) return d + 'd ago';
  return new Date(ts).toLocaleDateString();
}

/* --- Alias validation --- */
function isValidAlias(alias) {
  return /^[A-Za-z0-9_-]{1,32}$/.test(alias);
}

function isReservedAlias(alias) {
  return RESERVED_ALIASES.includes(alias.toLowerCase());
}

/* --- Random ID --- */
function generateId() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

/* --- Escape HTML --- */
function esc(str) {
  return String(str ?? '').replace(/[&<>"']/g, c => ({
    '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
  }[c]));
}

/* --- Toast --- */
function showToast(message, type = 'success', duration = 2600) {
  const toast = $('#toast');
  const icon = toast.querySelector('i');
  const msgEl = $('#toastMessage');

  msgEl.textContent = message;
  toast.className = 'show ' + type;
  icon.className = type === 'error'
    ? 'fas fa-circle-exclamation'
    : type === 'info'
      ? 'fas fa-circle-info'
      : 'fas fa-check-circle';

  clearTimeout(App.toastTimeout);
  App.toastTimeout = setTimeout(() => toast.classList.remove('show'), duration);
}

/* --- Clipboard (with fallback) --- */
async function copyToClipboard(text) {
  try {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return true;
    }
    // Fallback
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    ta.style.top = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(ta);
    return ok;
  } catch (e) {
    console.warn('Copy failed:', e);
    return false;
  }
}

/* ============================================================================
   STORAGE
   ============================================================================ */
const Storage = {
  getHistory() {
    try {
      const raw = localStorage.getItem(STORAGE.HISTORY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) { return []; }
  },
  setHistory(list) {
    try { localStorage.setItem(STORAGE.HISTORY, JSON.stringify(list.slice(0, MAX_HISTORY))); }
    catch (e) { console.warn('History save failed:', e); }
  },
  addHistory(entry) {
    const list = this.getHistory().filter(x => x.id !== entry.id);
    list.unshift(entry);
    this.setHistory(list);
    return list;
  },
  removeHistory(id) {
    const list = this.getHistory().filter(x => x.id !== id);
    this.setHistory(list);
    return list;
  },
  clearHistory() {
    try { localStorage.removeItem(STORAGE.HISTORY); } catch (e) {}
  },

  getAliases() {
    try {
      const raw = localStorage.getItem(STORAGE.ALIASES);
      return raw ? JSON.parse(raw) : {};
    } catch (e) { return {}; }
  },
  setAliases(map) {
    try { localStorage.setItem(STORAGE.ALIASES, JSON.stringify(map)); }
    catch (e) { console.warn('Alias save failed:', e); }
  },
  saveAlias(alias, url) {
    const m = this.getAliases();
    m[alias.toLowerCase()] = url;
    this.setAliases(m);
  },
  lookupAlias(alias) {
    const m = this.getAliases();
    return m[alias.toLowerCase()] || null;
  },
  aliasExists(alias) {
    return !!this.lookupAlias(alias);
  },

  getTheme() {
    try { return localStorage.getItem(STORAGE.THEME) || 'dark'; }
    catch (e) { return 'dark'; }
  },
  setTheme(t) {
    try { localStorage.setItem(STORAGE.THEME, t); } catch (e) {}
  }
};

/* ============================================================================
   THEME
   ============================================================================ */
function applyTheme(theme) {
  const html = document.documentElement;
  if (theme === 'dark') html.classList.add('dark');
  else html.classList.remove('dark');

  const knob = $('#themeKnob');
  if (knob) {
    knob.innerHTML = theme === 'dark'
      ? '<i class="fas fa-moon text-indigo-500"></i>'
      : '<i class="fas fa-sun text-amber-500"></i>';
  }
  Storage.setTheme(theme);
}

function toggleTheme() {
  const isDark = document.documentElement.classList.contains('dark');
  applyTheme(isDark ? 'light' : 'dark');
}

/* ============================================================================
   VIEW SWITCHER
   ============================================================================ */
function showView(name) {
  ['dashboardView', 'redirectView', 'errorView'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('hidden', id !== name + 'View' && id !== name);
  });
  // Scroll to top
  window.scrollTo({ top: 0, behavior: 'instant' });
}

function showDashboard() {
  cancelCountdown();
  document.getElementById('dashboardView').classList.remove('hidden');
  document.getElementById('redirectView').classList.add('hidden');
  document.getElementById('errorView').classList.add('hidden');
  document.title = 'SaivLINK — Shorten. Share. Simplify.';
  window.scrollTo({ top: 0, behavior: 'instant' });
}

function showRedirectView() {
  document.getElementById('dashboardView').classList.add('hidden');
  document.getElementById('redirectView').classList.remove('hidden');
  document.getElementById('errorView').classList.add('hidden');
  window.scrollTo({ top: 0, behavior: 'instant' });
}

function showErrorView(message) {
  cancelCountdown();
  document.getElementById('errorMessage').textContent = message || 'The short link you followed doesn\'t exist or has been removed.';
  document.getElementById('dashboardView').classList.add('hidden');
  document.getElementById('redirectView').classList.add('hidden');
  document.getElementById('errorView').classList.remove('hidden');
  document.title = 'Link Not Found — SaivLINK';
  window.scrollTo({ top: 0, behavior: 'instant' });
}

/* ============================================================================
   ROUTER
   ============================================================================ */
function getBasePath() {
  // Preserve path but strip hash & query for building short links
  return window.location.origin + window.location.pathname;
}

function buildShortUrl(encoded) {
  return getBasePath() + '#to=' + encoded;
}

function buildAliasUrl(alias) {
  return getBasePath() + '#s/' + alias;
}

function route() {
  const hash = window.location.hash || '';

  // Route: #to=ENCODED
  if (hash.startsWith('#to=')) {
    const encoded = hash.slice(4);
    const decoded = b64urlDecode(encoded);
    if (!decoded || !isValidHttpUrl(decoded)) {
      showErrorView('The encoded link is invalid or corrupted.');
      return;
    }
    enterRedirect(decoded);
    return;
  }

  // Route: #s/ALIAS
  if (hash.startsWith('#s/')) {
    const alias = hash.slice(3);
    if (!isValidAlias(alias)) {
      showErrorView('Invalid alias format.');
      return;
    }
    const url = Storage.lookupAlias(alias);
    if (!url) {
      showErrorView(`The alias "#s/${alias}" doesn't exist on this device. Custom aliases are stored locally — share the full "short link" instead, or create this alias in your own browser.`);
      return;
    }
    enterRedirect(url);
    return;
  }

  // Default: dashboard
  showDashboard();
}

/* ============================================================================
   REDIRECT VIEW LOGIC
   ============================================================================ */
function enterRedirect(targetUrl) {
  // Guard: don't redirect to self
  const current = window.location.href.split('#')[0];
  if (targetUrl.split('#')[0] === current) {
    showErrorView('This link points back to SaivLINK. Aborting to prevent a loop.');
    return;
  }

  // Populate destination preview
  const domain = getHostname(targetUrl) || 'unknown';
  const favicon = getFaviconUrl(targetUrl);
  const secure = isSecure(targetUrl);

  const faviconEl = $('#destFavicon');
  if (favicon) {
    faviconEl.src = favicon;
    faviconEl.style.display = '';
  } else {
    faviconEl.style.display = 'none';
  }

  $('#destDomain').textContent = domain;
  $('#destFullUrl').textContent = targetUrl;

  const badge = $('#destSafetyBadge');
  if (secure) {
    badge.className = 'safety-badge safety-safe';
    badge.innerHTML = '<i class="fas fa-lock text-[9px]"></i><span>Secure</span>';
  } else {
    badge.className = 'safety-badge safety-warn';
    badge.innerHTML = '<i class="fas fa-triangle-exclamation text-[9px]"></i><span>Not Secure</span>';
  }

  document.title = 'Redirecting to ' + domain + ' — SaivLINK';

  showRedirectView();
  startCountdown(targetUrl);
}

function startCountdown(targetUrl) {
  cancelCountdown();

  App.countdown.target = targetUrl;
  App.countdown.startTime = performance.now();
  App.countdown.completed = false;

  const progressCircle = $('#countdownProgress');
  const numberEl = $('#countdownNumber');
  const autoTimeEl = $('#autoRedirectTime');
  const skipBtn = $('#skipBtn');

  // Reset UI
  progressCircle.style.strokeDasharray = CIRCUMFERENCE;
  progressCircle.style.strokeDashoffset = 0;
  numberEl.textContent = COUNTDOWN_SECONDS;
  autoTimeEl.textContent = COUNTDOWN_SECONDS;
  skipBtn.disabled = false;

  let lastDisplayed = COUNTDOWN_SECONDS;

  function tick(now) {
    if (App.countdown.completed) return;

    const elapsed = now - App.countdown.startTime;
    const progress = Math.min(elapsed / App.countdown.duration, 1);
    const remainingMs = Math.max(0, App.countdown.duration - elapsed);
    const remainingSec = remainingMs / 1000;

    // Circle progress (smooth)
    const offset = CIRCUMFERENCE * progress;
    progressCircle.style.strokeDashoffset = offset;

    // Number (integer for display)
    const displayInt = Math.ceil(remainingSec);
    if (displayInt !== lastDisplayed) {
      lastDisplayed = displayInt;
      numberEl.textContent = displayInt;
      autoTimeEl.textContent = displayInt;
      // Small pop animation
      numberEl.style.transition = 'transform 0.15s ease';
      numberEl.style.transform = 'scale(1.08)';
      setTimeout(() => { numberEl.style.transform = 'scale(1)'; }, 150);
    }

    if (progress >= 1) {
      App.countdown.completed = true;
      performRedirect();
      return;
    }

    App.countdown.raf = requestAnimationFrame(tick);
  }

  App.countdown.raf = requestAnimationFrame(tick);
}

function cancelCountdown() {
  if (App.countdown.raf) {
    cancelAnimationFrame(App.countdown.raf);
    App.countdown.raf = null;
  }
  App.countdown.completed = false;
}

function performRedirect() {
  const target = App.countdown.target;
  if (!target) return;

  cancelCountdown();

  // Visual feedback before jumping
  const numberEl = $('#countdownNumber');
  if (numberEl) numberEl.textContent = '→';

  // Slight delay for a smoother transition
  setTimeout(() => {
    try {
      window.location.href = target;
    } catch (e) {
      showErrorView('Unable to redirect to the destination.');
    }
  }, 180);
}

/* ============================================================================
   DASHBOARD — Generate & Render
   ============================================================================ */

function validateUrlInput(showError = true) {
  const input = $('#urlInput');
  const errorEl = $('#urlError');
  const raw = input.value.trim();

  if (!raw) {
    if (showError) showError(errorEl, 'Please enter a URL.');
    return null;
  }

  const normalized = normalizeUrl(raw);
  if (!isValidHttpUrl(normalized)) {
    if (showError) showError(errorEl, 'That doesn\'t look like a valid URL.');
    return null;
  }

  hideError(errorEl);
  return normalized;
}

function validateAliasInput(showError = true) {
  const input = $('#aliasInput');
  const errorEl = $('#aliasHint');
  const raw = input.value.trim();

  if (!raw) return ''; // optional

  if (!isValidAlias(raw)) {
    if (showError) {
      errorEl.classList.remove('text-slate-500', 'dark:text-slate-500');
      errorEl.classList.add('text-red-500');
      errorEl.innerHTML = '<i class="fas fa-circle-exclamation mr-1"></i>Invalid alias. Use letters, numbers, dashes or underscores (max 32 chars).';
    }
    return null;
  }

  if (isReservedAlias(raw)) {
    if (showError) {
      errorEl.classList.remove('text-slate-500', 'dark:text-slate-500');
      errorEl.classList.add('text-red-500');
      errorEl.innerHTML = '<i class="fas fa-circle-exclamation mr-1"></i>That alias is reserved. Try another.';
    }
    return null;
  }

  if (Storage.aliasExists(raw)) {
    if (showError) {
      errorEl.classList.remove('text-slate-500', 'dark:text-slate-500');
      errorEl.classList.add('text-red-500');
      errorEl.innerHTML = '<i class="fas fa-circle-exclamation mr-1"></i>That alias is already in use.';
    }
    return null;
  }

  // Reset hint
  errorEl.classList.remove('text-red-500');
  errorEl.classList.add('text-slate-500', 'dark:text-slate-500');
  errorEl.innerHTML = '<i class="fas fa-info-circle mr-1"></i>Letters, numbers, dashes and underscores. Local-only: works on this device.';
  return raw;
}

function showError(el, msg) {
  if (!el) return;
  el.classList.remove('hidden');
  const span = el.querySelector('span');
  if (span) span.textContent = msg;
}

function hideError(el) {
  if (!el) return;
  el.classList.add('hidden');
}

function handleGenerate(e) {
  if (e) e.preventDefault();

  const url = validateUrlInput();
  if (!url) return;

  const alias = validateAliasInput();
  if (alias === null) return;

  const encoded = b64urlEncode(url);
  if (!encoded) {
    showToast('Failed to encode URL.', 'error');
    return;
  }

  const shortUrl = buildShortUrl(encoded);
  const id = generateId();
  const entry = {
    id,
    original: url,
    short: shortUrl,
    alias: alias || '',
    createdAt: Date.now()
  };

  // Persist alias → url mapping
  if (alias) {
    Storage.saveAlias(alias, url);
    entry.aliasShort = buildAliasUrl(alias);
  }

  Storage.addHistory(entry);
  App.currentResult = entry;

  renderResult(entry);
  renderHistory();
  showToast(alias ? `Short link created with alias "${alias}"` : 'Short link created!', 'success');
}

function renderResult(entry) {
  const card = $('#resultCard');
  if (!card) return;

  $('#shortLinkText').textContent = entry.short;
  $('#originalUrlText').textContent = entry.original;

  card.classList.remove('hidden');
  card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  // Generate QR
  renderQR(entry.short);
}

function renderQR(text) {
  const container = $('#qrcodeContainer');
  if (!container || typeof QRCode === 'undefined') return;

  container.innerHTML = '';

  try {
    new QRCode(container, {
      text: text,
      width: 180,
      height: 180,
      colorDark: '#0f172a',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.H
    });
  } catch (e) {
    console.error('QR generation failed:', e);
    container.innerHTML = '<div class="text-xs text-slate-500 p-4">QR unavailable</div>';
  }
}

function downloadQR() {
  const container = $('#qrcodeContainer');
  if (!container) return;

  const canvas = container.querySelector('canvas');
  const img = container.querySelector('img');

  let dataUrl = '';
  if (canvas) dataUrl = canvas.toDataURL('image/png');
  else if (img && img.src) dataUrl = img.src;

  if (!dataUrl) {
    showToast('QR not ready yet.', 'error');
    return;
  }

  const a = document.createElement('a');
  a.href = dataUrl;
  a.download = 'saivlink-qr-' + Date.now() + '.png';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  showToast('QR code downloaded!', 'success');
}

/* ============================================================================
   HISTORY RENDERING
   ============================================================================ */
function renderHistory() {
  const section = $('#historySection');
  const list = $('#historyList');
  const countEl = $('#historyCount');
  if (!section || !list) return;

  const items = Storage.getHistory();
  countEl.textContent = items.length;

  if (items.length === 0) {
    section.classList.add('hidden');
    list.innerHTML = '';
    return;
  }
  section.classList.remove('hidden');

  // Build DOM safely
  list.innerHTML = '';
  items.forEach(item => {
    const row = document.createElement('div');
    row.className = 'history-item';

    // Favicon
    const favWrap = document.createElement('div');
    favWrap.className = 'w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-100 to-violet-100 dark:from-indigo-500/20 dark:to-violet-500/20 flex items-center justify-center flex-shrink-0 overflow-hidden';
    const favUrl = getFaviconUrl(item.original);
    if (favUrl) {
      const img = document.createElement('img');
      img.src = favUrl;
      img.alt = '';
      img.className = 'w-6 h-6';
      img.onerror = () => {
        favWrap.innerHTML = '<i class="fas fa-link text-indigo-500"></i>';
      };
      favWrap.appendChild(img);
    } else {
      favWrap.innerHTML = '<i class="fas fa-link text-indigo-500"></i>';
    }

    // Info
    const info = document.createElement('div');
    info.className = 'flex-1 min-w-0';

    const domain = document.createElement('div');
    domain.className = 'flex items-center gap-2 mb-0.5';
    const domainText = document.createElement('span');
    domainText.className = 'font-bold text-sm truncate';
    domainText.textContent = getHostname(item.original) || 'link';
    domain.appendChild(domainText);
    if (item.alias) {
      const aliasBadge = document.createElement('span');
      aliasBadge.className = 'text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-indigo-100 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-300 flex-shrink-0';
      aliasBadge.textContent = '#' + item.alias;
      domain.appendChild(aliasBadge);
    }

    const originalText = document.createElement('p');
    originalText.className = 'text-xs text-slate-500 dark:text-slate-400 truncate font-mono';
    originalText.textContent = truncateUrl(item.original, 70);

    const timeText = document.createElement('p');
    timeText.className = 'text-[10px] text-slate-400 dark:text-slate-500 mt-0.5';
    timeText.textContent = timeAgo(item.createdAt);

    info.appendChild(domain);
    info.appendChild(originalText);
    info.appendChild(timeText);

    // Actions
    const actions = document.createElement('div');
    actions.className = 'flex items-center gap-1.5 flex-shrink-0';

    const copyBtn = document.createElement('button');
    copyBtn.className = 'icon-btn';
    copyBtn.title = 'Copy short link';
    copyBtn.innerHTML = '<i class="fas fa-copy"></i>';
    copyBtn.addEventListener('click', async () => {
      const ok = await copyToClipboard(item.short);
      showToast(ok ? 'Short link copied!' : 'Copy failed', ok ? 'success' : 'error');
    });

    const openBtn = document.createElement('button');
    openBtn.className = 'icon-btn';
    openBtn.title = 'Open link';
    openBtn.innerHTML = '<i class="fas fa-arrow-up-right-from-square"></i>';
    openBtn.addEventListener('click', () => {
      window.open(item.short, '_blank', 'noopener');
    });

    const delBtn = document.createElement('button');
    delBtn.className = 'icon-btn danger';
    delBtn.title = 'Delete';
    delBtn.innerHTML = '<i class="fas fa-trash-can"></i>';
    delBtn.addEventListener('click', () => {
      Storage.removeHistory(item.id);
      if (item.alias) {
        const m = Storage.getAliases();
        delete m[item.alias.toLowerCase()];
        Storage.setAliases(m);
      }
      renderHistory();
      showToast('Link removed', 'info');
    });

    actions.appendChild(copyBtn);
    actions.appendChild(openBtn);
    actions.appendChild(delBtn);

    row.appendChild(favWrap);
    row.appendChild(info);
    row.appendChild(actions);
    list.appendChild(row);
  });
}

/* ============================================================================
   EVENT BINDINGS
   ============================================================================ */
function bindDashboardEvents() {
  // Form submit
  const form = $('#generateForm');
  if (form) form.addEventListener('submit', handleGenerate);

  // Clear URL error on input
  const urlInput = $('#urlInput');
  if (urlInput) {
    urlInput.addEventListener('input', () => {
      hideError($('#urlError'));
    });
  }

  // Clear alias error on input
  const aliasInput = $('#aliasInput');
  if (aliasInput) {
    aliasInput.addEventListener('input', () => {
      // Reset hint style
      const hint = $('#aliasHint');
      hint.classList.remove('text-red-500');
      hint.classList.add('text-slate-500', 'dark:text-slate-500');
      hint.innerHTML = '<i class="fas fa-info-circle mr-1"></i>Letters, numbers, dashes and underscores. Local-only: works on this device.';
      // Sanitize
      aliasInput.value = aliasInput.value.replace(/[^A-Za-z0-9_-]/g, '');
    });
  }

  // Paste button
  const pasteBtn = $('#pasteBtn');
  if (pasteBtn) {
    pasteBtn.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          urlInput.value = text.trim();
          hideError($('#urlError'));
        } else {
          showToast('Clipboard is empty', 'info');
        }
      } catch (e) {
        showToast('Clipboard access denied — paste manually', 'error');
      }
    });
  }

  // Copy short link
  const copyShortBtn = $('#copyShortBtn');
  if (copyShortBtn) {
    copyShortBtn.addEventListener('click', async () => {
      if (!App.currentResult) return;
      const ok = await copyToClipboard(App.currentResult.short);
      showToast(ok ? 'Short link copied to clipboard!' : 'Copy failed', ok ? 'success' : 'error');
      if (ok) {
        const orig = copyShortBtn.innerHTML;
        copyShortBtn.innerHTML = '<i class="fas fa-check text-base"></i>';
        setTimeout(() => { copyShortBtn.innerHTML = orig; }, 1400);
      }
    });
  }

  // Copy both (details)
  const copyBothBtn = $('#copyBothBtn');
  if (copyBothBtn) {
    copyBothBtn.addEventListener('click', async () => {
      if (!App.currentResult) return;
      const text = `Short link: ${App.currentResult.short}\nOriginal:   ${App.currentResult.original}`;
      const ok = await copyToClipboard(text);
      showToast(ok ? 'Details copied!' : 'Copy failed', ok ? 'success' : 'error');
    });
  }

  // Test link
  const testLinkBtn = $('#testLinkBtn');
  if (testLinkBtn) {
    testLinkBtn.addEventListener('click', () => {
      if (!App.currentResult) return;
      window.location.hash = '#to=' + b64urlEncode(App.currentResult.original);
    });
  }

  // New link
  const newLinkBtn = $('#newLinkBtn');
  if (newLinkBtn) {
    newLinkBtn.addEventListener('click', () => {
      $('#urlInput').value = '';
      $('#aliasInput').value = '';
      hideError($('#urlError'));
      $('#resultCard').classList.add('hidden');
      App.currentResult = null;
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => $('#urlInput').focus(), 300);
    });
  }

  // Download QR
  const downloadQrBtn = $('#downloadQrBtn');
  if (downloadQrBtn) downloadQrBtn.addEventListener('click', downloadQR);

  // Clear history
  const clearHistoryBtn = $('#clearHistoryBtn');
  if (clearHistoryBtn) {
    clearHistoryBtn.addEventListener('click', () => {
      if (!confirm('Delete all link history? This cannot be undone.')) return;
      Storage.clearHistory();
      // Also clear aliases since they'd be orphaned
      Storage.setAliases({});
      renderHistory();
      showToast('All history cleared', 'info');
    });
  }
}

function bindRedirectEvents() {
  // Skip button
  const skipBtn = $('#skipBtn');
  if (skipBtn) {
    skipBtn.addEventListener('click', () => {
      performRedirect();
    });
  }

  // Cancel
  const cancelBtn = $('#cancelRedirect');
  if (cancelBtn) {
    cancelBtn.addEventListener('click', (e) => {
      e.preventDefault();
      cancelCountdown();
      window.location.hash = '';
    });
  }
}

function bindGlobalEvents() {
  // Theme toggle
  const themeToggle = $('#themeToggle');
  if (themeToggle) themeToggle.addEventListener('click', toggleTheme);

  // Hash routing
  window.addEventListener('hashchange', route);

  // Keyboard shortcuts
  window.addEventListener('keydown', (e) => {
    // Ctrl/Cmd + K focus URL input
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      const urlInput = $('#urlInput');
      if (urlInput && !document.getElementById('dashboardView').classList.contains('hidden')) {
        urlInput.focus();
        urlInput.select();
      }
    }
    // Escape cancels countdown if in redirect view
    if (e.key === 'Escape' && !document.getElementById('redirectView').classList.contains('hidden')) {
      cancelCountdown();
      window.location.hash = '';
    }
  });

  // Autofocus URL input on desktop
  if (window.matchMedia('(min-width: 768px)').matches) {
    const urlInput = $('#urlInput');
    if (urlInput) setTimeout(() => urlInput.focus(), 400);
  }
}

/* ============================================================================
   INIT
   ============================================================================ */
function init() {
  // Apply saved theme
  applyTheme(Storage.getTheme());

  // Bind events
  bindDashboardEvents();
  bindRedirectEvents();
  bindGlobalEvents();

  // Initial history render
  renderHistory();

  // Initial route
  route();
}

// Boot
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

})();
</script>

