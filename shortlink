<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SaivLINK — Shorten. Share. Simplify.</title>

<!-- Favicon (emoji SVG) -->
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔗</text></svg>">

<!-- Tailwind -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'system-ui', 'sans-serif'],
          mono: ['JetBrains Mono', 'ui-monospace', 'monospace']
        },
        animation: {
          'fade-in': 'fadeIn 0.4s ease-out',
          'slide-up': 'slideUp 0.45s cubic-bezier(0.16, 1, 0.3, 1)',
          'pop-in': 'popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)',
          'float': 'float 6s ease-in-out infinite',
          'shimmer': 'shimmer 2s linear infinite',
          'pulse-glow': 'pulseGlow 2s ease-in-out infinite'
        },
        keyframes: {
          fadeIn: { '0%': { opacity: 0 }, '100%': { opacity: 1 } },
          slideUp: { '0%': { opacity: 0, transform: 'translateY(20px)' }, '100%': { opacity: 1, transform: 'translateY(0)' } },
          popIn: { '0%': { opacity: 0, transform: 'scale(0.9)' }, '100%': { opacity: 1, transform: 'scale(1)' } },
          float: { '0%, 100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-12px)' } },
          shimmer: { '0%': { backgroundPosition: '-200% 0' }, '100%': { backgroundPosition: '200% 0' } },
          pulseGlow: { '0%, 100%': { opacity: 0.5 }, '50%': { opacity: 1 } }
        }
      }
    }
  }
</script>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- QR Code library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
  :root {
    --brand-1: #6366f1;
    --brand-2: #a855f7;
    --brand-3: #ec4899;
  }

  * { -webkit-tap-highlight-color: transparent; }

  html, body {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    background: #f8fafc;
    transition: background-color 0.4s ease, color 0.4s ease;
  }
  html.dark body {
    background: #020617;
  }

  /* Animated background orbs */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(900px 600px at 15% -10%, rgba(99,102,241,0.18), transparent 60%),
      radial-gradient(800px 500px at 95% 0%, rgba(236,72,153,0.14), transparent 55%),
      radial-gradient(700px 500px at 50% 110%, rgba(56,189,248,0.12), transparent 60%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  html.dark body::before {
    background:
      radial-gradient(900px 600px at 15% -10%, rgba(99,102,241,0.28), transparent 60%),
      radial-gradient(800px 500px at 95% 0%, rgba(236,72,153,0.22), transparent 55%),
      radial-gradient(700px 500px at 50% 110%, rgba(56,189,248,0.18), transparent 60%);
  }

  /* Subtle grid overlay */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(99,102,241,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99,102,241,0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
    pointer-events: none;
  }
  html.dark body::after {
    background-image:
      linear-gradient(rgba(129,140,248,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(129,140,248,0.06) 1px, transparent 1px);
  }

  /* Glass card */
  .glass {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 12px 32px -12px rgba(15, 23, 42, 0.12);
  }
  html.dark .glass {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(148, 163, 184, 0.14);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 16px 40px -16px rgba(0, 0, 0, 0.6);
  }

  /* Input */
  .input-base {
    width: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1.5px solid rgba(148, 163, 184, 0.3);
    background: rgba(255, 255, 255, 0.9);
    color: #0f172a;
    font-size: 0.95rem;
    outline: none;
    transition: all 0.2s ease;
  }
  html.dark .input-base {
    background: rgba(2, 6, 23, 0.5);
    border-color: rgba(148, 163, 184, 0.18);
    color: #e2e8f0;
  }
  .input-base::placeholder { color: rgba(100, 116, 139, 0.7); }
  html.dark .input-base::placeholder { color: rgba(148, 163, 184, 0.6); }
  .input-base:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    background: #fff;
  }
  html.dark .input-base:focus {
    background: rgba(2, 6, 23, 0.9);
    border-color: #818cf8;
    box-shadow: 0 0 0 4px rgba(129, 140, 248, 0.18);
  }

  /* Brand gradient text */
  .brand-text {
    background: linear-gradient(135deg, #818cf8 0%, #c084fc 50%, #f472b6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Brand gradient button */
  .btn-brand {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #6366f1, #a855f7 55%, #ec4899);
    background-size: 200% 200%;
    animation: gradientShift 6s ease infinite;
    color: #fff;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 30px -10px rgba(139, 92, 246, 0.6);
  }
  .btn-brand:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 40px -12px rgba(139, 92, 246, 0.8);
  }
  .btn-brand:active { transform: translateY(0) scale(0.98); }
  .btn-brand:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    animation: none;
    transform: none;
  }
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 12px;
    border: 1.5px solid rgba(148, 163, 184, 0.3);
    background: rgba(255, 255, 255, 0.6);
    color: #334155;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  html.dark .btn-ghost {
    background: rgba(15, 23, 42, 0.5);
    border-color: rgba(148, 163, 184, 0.18);
    color: #cbd5e1;
  }
  .btn-ghost:hover {
    border-color: #6366f1;
    color: #4f46e5;
    transform: translateY(-1px);
  }
  html.dark .btn-ghost:hover {
    border-color: #818cf8;
    color: #a5b4fc;
    background: rgba(30, 41, 59, 0.5);
  }

  /* Short link display */
  .shortlink-box {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    word-break: break-all;
    background: linear-gradient(135deg, rgba(99,102,241,0.06), rgba(236,72,153,0.06));
    border: 1.5px dashed rgba(99,102,241,0.35);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #4f46e5;
    transition: all 0.2s ease;
  }
  html.dark .shortlink-box {
    background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(236,72,153,0.08));
    border-color: rgba(129,140,248,0.35);
    color: #a5b4fc;
  }

  /* Theme toggle */
  .theme-toggle {
    position: relative;
    width: 58px;
    height: 30px;
    border-radius: 999px;
    background: linear-gradient(135deg, #fbbf24, #f97316);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease;
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.15);
  }
  html.dark .theme-toggle {
    background: linear-gradient(135deg, #4f46e5, #8b5cf6);
  }
  .theme-toggle .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
  html.dark .theme-toggle .knob { transform: translateX(28px); }

  /* Countdown circle */
  .countdown-wrap {
    position: relative;
    width: 180px;
    height: 180px;
    margin: 0 auto;
  }
  @media (min-width: 640px) {
    .countdown-wrap { width: 220px; height: 220px; }
  }
  .countdown-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .countdown-track {
    fill: none;
    stroke: rgba(148, 163, 184, 0.18);
    stroke-width: 8;
  }
  html.dark .countdown-track { stroke: rgba(148, 163, 184, 0.12); }
  .countdown-progress {
    fill: none;
    stroke: url(#countdownGradient);
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.1s linear;
    filter: drop-shadow(0 0 8px rgba(139, 92, 246, 0.6));
  }
  .countdown-number {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #818cf8, #c084fc 50%, #f472b6);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: pulseGlow 2s ease-in-out infinite;
  }
  @media (min-width: 640px) {
    .countdown-number { font-size: 5rem; }
  }
  @keyframes pulseGlow {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.03); }
  }

  /* History item */
  .history-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(255,255,255,0.6);
    border: 1px solid rgba(148,163,184,0.18);
    transition: all 0.18s ease;
  }
  html.dark .history-item {
    background: rgba(15, 23, 42, 0.5);
    border-color: rgba(148, 163, 184, 0.12);
  }
  .history-item:hover {
    border-color: rgba(99,102,241,0.4);
    transform: translateY(-1px);
    box-shadow: 0 10px 24px -12px rgba(15,23,42,0.25);
  }
  html.dark .history-item:hover {
    border-color: rgba(129,140,248,0.35);
    box-shadow: 0 10px 24px -12px rgba(0,0,0,0.6);
  }

  /* Icon button */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid rgba(148,163,184,0.22);
    background: rgba(255,255,255,0.7);
    color: #475569;
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 0.85rem;
  }
  html.dark .icon-btn {
    background: rgba(15, 23, 42, 0.6);
    border-color: rgba(148, 163, 184, 0.16);
    color: #94a3b8;
  }
  .icon-btn:hover {
    border-color: #6366f1;
    color: #4f46e5;
    transform: translateY(-1px);
  }
  html.dark .icon-btn:hover {
    border-color: #818cf8;
    color: #a5b4fc;
    background: rgba(30, 41, 59, 0.7);
  }
  .icon-btn.danger:hover {
    border-color: #ef4444;
    color: #dc2626;
  }
  html.dark .icon-btn.danger:hover {
    border-color: #f87171;
    color: #fca5a5;
  }

  /* Toast */
  #toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(120px);
    padding: 12px 20px;
    border-radius: 14px;
    background: #0f172a;
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 24px 48px -12px rgba(0,0,0,0.4);
    opacity: 0;
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 9999;
    max-width: calc(100vw - 32px);
  }
  #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  #toast.success { background: linear-gradient(135deg, #059669, #10b981); }
  #toast.error { background: linear-gradient(135deg, #dc2626, #ef4444); }
  #toast.info { background: linear-gradient(135deg, #4f46e5, #7c3aed); }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: rgba(99,102,241,0.3);
    border-radius: 8px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  ::-webkit-scrollbar-thumb:hover { background: rgba(99,102,241,0.55); background-clip: padding-box; }
  html.dark ::-webkit-scrollbar-thumb { background: rgba(129,140,248,0.35); background-clip: padding-box; }

  /* Safety badge */
  .safety-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .safety-safe {
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
  }
  html.dark .safety-safe {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
  }
  .safety-warn {
    background: rgba(245, 158, 11, 0.15);
    color: #d97706;
  }
  html.dark .safety-warn {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
  }

  /* Stagger animation */
  .stagger > * { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards; }
  .stagger > *:nth-child(1) { animation-delay: 0.05s; }
  .stagger > *:nth-child(2) { animation-delay: 0.1s; }
  .stagger > *:nth-child(3) { animation-delay: 0.15s; }
  .stagger > *:nth-child(4) { animation-delay: 0.2s; }
  .stagger > *:nth-child(5) { animation-delay: 0.25s; }
  .stagger > *:nth-child(6) { animation-delay: 0.3s; }

  /* QR wrapper */
  #qrcodeContainer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 10px 24px -10px rgba(15, 23, 42, 0.25);
  }
  html.dark #qrcodeContainer {
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.5);
  }
  #qrcodeContainer canvas,
  #qrcodeContainer img { display: block; border-radius: 8px; }

  /* Hide number input spinner etc */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* Prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
</head>

<body class="text-slate-800 dark:text-slate-100 antialiased">

<!-- ============================== DASHBOARD VIEW ============================== -->
<div id="dashboardView">

  <!-- Navbar -->
  <nav class="sticky top-0 z-40 backdrop-blur-xl bg-white/60 dark:bg-slate-950/60 border-b border-slate-200/50 dark:border-slate-800/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center gap-2.5 group">
        <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 via-violet-500 to-pink-500 flex items-center justify-center text-white shadow-lg shadow-violet-500/30 group-hover:scale-105 transition">
          <i class="fas fa-link text-base"></i>
        </div>
        <span class="font-extrabold text-xl tracking-tight">
          <span class="brand-text">SaivLINK</span>
        </span>
      </a>

      <div class="flex items-center gap-3">
        <a href="https://github.com" target="_blank" rel="noopener" class="icon-btn hidden sm:inline-flex" title="GitHub">
          <i class="fab fa-github"></i>
        </a>
        <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle theme">
          <span class="knob" id="themeKnob"><i class="fas fa-sun text-amber-500"></i></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Main -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">

    <!-- Hero -->
    <section class="text-center mb-10 sm:mb-14 stagger">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200/60 dark:border-indigo-400/20 text-indigo-600 dark:text-indigo-300 text-xs font-bold mb-5">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
        </span>
        <span>100% Client-Side · No Backend Required</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-[1.05] mb-4">
        Shorten. Share.<br>
        <span class="brand-text">Simplify.</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Transform any long URL into a clean, shareable short link with built-in QR codes,
        a stunning redirect page, and full history — all running privately in your browser.
      </p>
    </section>

    <!-- Generator Card -->
    <section class="glass rounded-3xl p-6 sm:p-8 mb-8 animate-fade-in">
      <form id="generateForm" autocomplete="off">
        <div class="mb-5">
          <label for="urlInput" class="flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300 mb-2.5">
            <i class="fas fa-globe text-indigo-500"></i>
            <span>Paste your long URL</span>
          </label>
          <div class="relative">
            <input
              id="urlInput"
              type="text"
              class="input-base pr-12"
              placeholder="https://example.com/very/long/path?with=params"
              required
            >
            <button type="button" id="pasteBtn" class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-lg flex items-center justify-center text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition" title="Paste from clipboard">
              <i class="fas fa-paste"></i>
            </button>
          </div>
          <p id="urlError" class="text-xs text-red-500 font-medium mt-2 hidden">
            <i class="fas fa-circle-exclamation mr-1"></i><span></span>
          </p>
        </div>

        <div class="mb-6">
          <label for="aliasInput" class="flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300 mb-2.5">
            <i class="fas fa-tag text-indigo-500"></i>
            <span>Custom alias <span class="font-normal text-slate-400 dark:text-slate-500">(optional — stored locally)</span></span>
          </label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-sm font-mono pointer-events-none select-none">#s/</span>
            <input
              id="aliasInput"
              type="text"
              class="input-base pl-14 font-mono"
              placeholder="my-link"
              maxlength="32"
              pattern="[A-Za-z0-9_-]+"
            >
          </div>
          <p id="aliasHint" class="text-xs text-slate-500 dark:text-slate-500 mt-2">
            <i class="fas fa-info-circle mr-1"></i>
            Letters, numbers, dashes and underscores. Local-only: works on this device.
          </p>
        </div>

        <button type="submit" id="generateBtn" class="btn-brand w-full py-4 px-6 rounded-2xl text-base font-bold flex items-center justify-center gap-3">
          <i class="fas fa-wand-magic-sparkles text-lg"></i>
          <span>Generate Short Link</span>
        </button>
      </form>
    </section>

    <!-- Result Card -->
    <section id="resultCard" class="hidden glass rounded-3xl p-6 sm:p-8 mb-8 animate-pop-in">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/30">
          <i class="fas fa-check text-lg"></i>
        </div>
        <div>
          <h2 class="font-extrabold text-lg">Your short link is ready!</h2>
